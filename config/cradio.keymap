#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define SYM    1
#define SYM_2  2
#define FNC    3
#define FNC_2  4
#define NUMPAD 5

// ZMK has no parent->child property inheritance: combos need timeout-ms and
// require-prior-idle-ms set per combo, otherwise they silently fall back to
// 50 ms / -1 (disabled) regardless of what the combos node says.
//
// combo_c: common variant (active on BASE..FNC).
#define ZMK_COMBO_C(n, b, kp, i) \
    n { bindings = <b>; key-positions = <kp>; layers = <BASE SYM SYM_2 FNC>; timeout-ms = <50>; require-prior-idle-ms = <i>; };

// combo_a: "everywhere" variant (all layers, for Escape-style combos).
#define ZMK_COMBO_A(n, b, kp, i) \
    n { bindings = <b>; key-positions = <kp>; layers = <BASE SYM SYM_2 FNC FNC_2 NUMPAD>; timeout-ms = <50>; require-prior-idle-ms = <i>; };

&mt {
    // &mt is only used for tap/tap pairs (COLON+COMMA, UNDER+MINUS) where
    // tap-preferred + a prior-idle guard would only delay the shifted side.
    // Tap/tap resolution never depends on prior idle, so no guard is needed.
    tapping-term-ms = <250>;
    flavor = "tap-preferred";
};

&lt {
    require-prior-idle-ms = <100>;
};

&sl {
    release-after-ms = <3000>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // Destructive / high-risk combos get 150 ms idle, the rest 80 ms.
        // Idle guard: the combo key pair must be pressed after that much
        // typing silence, so fast rolls can't fire them accidentally.
        esc { bindings = <&kp ESCAPE>; key-positions = <0 1>; layers = <BASE SYM SYM_2 FNC FNC_2 NUMPAD>; timeout-ms = <50>; require-prior-idle-ms = <0>; };
        ZMK_COMBO_C(cut,            &kp LC(X),       21 22,  80)
        ZMK_COMBO_C(copy,           &kp LC(C),       22 23,  80)
        ZMK_COMBO_C(paste,          &kp LC(V),       23 24,  80)
        ZMK_COMBO_A(to_default,     &to BASE,        0 9,    80)
        alt_quotes {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <5 6>;
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <80>;
        };
        numpad {
            bindings = <&to NUMPAD>;
            key-positions = <7 8 9>;
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <80>;
        };
        ZMK_COMBO_C(backspace,      &kp BACKSPACE,   3 2,    150)
        ZMK_COMBO_C(delete,         &kp DELETE,      6 7,    150)
        settings {
            bindings = <&to FNC_2>;
            key-positions = <0 1 2>;
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <80>;
        };
        improve_prompt {
            bindings = <&llm_prompt>;
            key-positions = <30 31>;
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };
        ZMK_COMBO_C(alt_ret,        &kp RET,         14 13,  150)
        capsword {
            bindings = <&caps_word>;
            key-positions = <29 28>;
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <80>;
        };
        ZMK_COMBO_C(alt_tab,        &kp TAB,         15 16,  80)
        ZMK_COMBO_A(studio_unlock,  &studio_unlock,  20 10 0, 80)
        sym_once {
            // Was &sk SYM: &sk is a sticky *key* and wraps &kp, so this
            // emitted HID keycode 1 instead of the SYM layer.
            bindings = <&sl SYM>;
            key-positions = <20 21>;
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <80>;
        };
        ZMK_COMBO_C(undo,           &kp LC(Z),       24 25,  80)
        ZMK_COMBO_C(redo,           &kp LS(LC(Z)),   25 26,  80)
        // Word-deletion pair: F+W sits one column left of the backspace combo
        // (F+P), T+D is its left/right mirror on the home row.
        ZMK_COMBO_C(word_backspace, &kp LC(BACKSPACE), 1 2,  150)
        ZMK_COMBO_C(word_delete,    &kp LC(DELETE),  14 15,  150)
    };

    macros {
        llm_prompt: llm_prompt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings
                = <&kp LS(RET)>
                , <&kp I &kp M &kp P &kp R &kp O &kp V &kp E>
                , <&kp SPACE>
                , <&kp T &kp H &kp I &kp S>
                , <&kp SPACE>
                , <&kp T &kp E &kp X &kp T>
                , <&kp SPACE>
                , <&kp A &kp N &kp D>
                , <&kp SPACE>
                , <&kp M &kp A &kp K &kp E>
                , <&kp SPACE>
                , <&kp I &kp T>
                , <&kp SPACE>
                , <&kp C &kp O &kp N &kp C &kp I &kp S &kp E>
                , <&kp LC(RET)>
                ;
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
            hold-trigger-on-release;
            display-name = "Home Row Mod Left";
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
            hold-trigger-on-release;
            display-name = "Home Row Mod Right";
        };

        hmr_ralt: home_row_mod_right_ralt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            // Left-hand keys + U(7)/O(19) on the same hand so AltGr+u/o
            // (ü/ö via the AHK script) can chord on the right hand.
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 7 19>;
            hold-trigger-on-release;
            display-name = "Home Row Mod Right AltGr";
        };

        // Thumb AltGr experiment: same timing as the home-row mods, but on the
        // left thumb (position 30, previously the redundant &mo SYM) so
        // home-row rolls can never leak an umlaut. The main SYM access stays
        // on the right thumb (&lt SYM RET). Tap does nothing (&none) — the key
        // is hold-only. Positional guard stays off: the thumb is deliberately
        // chorded with either hand — ö/ü are cross-hand, ä/ß are same-hand but
        // thumb vs pinky/ring rarely rolls.
        hm_altgr: home_row_mod_altgr_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&none>;
            hold-trigger-on-release;
            display-name = "AltGr Thumb (experiment)";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Colemak";
            bindings = <
&kp Q            &kp W           &kp F        &kp P             &kp B        &kp J      &kp L              &kp U        &kp Y            &mt UNDER MINUS
&hml LGUI A  &hml LALT R  &hml LCTRL S  &hml LSHFT T  &kp G        &kp M      &hmr RSHFT N  &hmr RCTRL E  &hmr_ralt RALT I  &hmr RGUI O
&lt SYM_2 Z          &kp X           &kp C        &kp D             &kp V        &kp SLASH  &kp K              &kp H        &mt COLON COMMA  &lt SYM_2 DOT
                                              &hm_altgr RALT 0    &kp SPACE    &mo FNC    &lt SYM RET
            >;
        };

        symbol {
            display-name = "Symbols";
            bindings = <
&kp HASH            &kp AT              &kp LESS_THAN         &kp GREATER_THAN       &kp TILDE           &kp MINUS  &kp LEFT_BRACE                    &kp RIGHT_BRACE              &kp GRAVE                   &kp COLON
&hml LGUI CARET  &hml LALT EQUAL  &hml LCTRL UNDERSCORE  &hml LSHFT DOLLAR  &kp ASTERISK        &kp PLUS   &hmr RSHFT LEFT_PARENTHESIS  &hmr RCTRL RIGHT_PARENTHESIS  &hmr RALT LEFT_BRACKET  &hmr RGUI RIGHT_BRACKET
&kp BACKSLASH       &kp PIPE            &kp PRCNT             &kp SEMI               &kp SINGLE_QUOTE    &kp DQT    &kp EXCL                          &kp AMPS                     &kp UNDER                   &kp SLASH
                                                              &trans                 &trans              &trans     &trans
            >;
        };

        number-and-fn {
            display-name = "Numbers & Fn";
            bindings = <
&kp N9             &kp N5       &kp N0         &kp NUMBER_3       &kp N7    &kp N6  &kp NUMBER_2          &kp NUMBER_1       &kp NUMBER_4             &kp N8
&hml LGUI EXCL  &hml LALT AT  &hml LCTRL SQT  &hml LSHFT F4  &trans    &trans  &hmr RSHFT HOME  &hmr RCTRL PAGE_UP  &hmr RALT PAGE_DOWN  &hmr RGUI END
&kp F1             &kp F2       &kp F3         &kp F4             &kp F5    &kp F6  &kp F7                &kp F8             &kp F11                  &kp F12
                                               &trans             &trans    &trans  &trans
            >;
        };

        arrows_wm {
            display-name = "Arrows / WM";
            bindings = <
&to BASE      &kp LG(LS(N5))  &kp UP_ARROW  &kp LG(LS(NUMBER_3))  &trans         &kp LG(LS(NUMBER_6))  &kp LG(LS(NUMBER_2))  &kp LG(LS(NUMBER_1))  &kp LG(LS(NUMBER_4))  &kp LG(LS(N8))
&kp F13  &kp LEFT        &kp DOWN      &kp RIGHT             &kp F14        &kp LG(NUMBER_6)      &kp LG(NUMBER_2)      &kp LG(NUMBER_1)      &kp LG(NUMBER_4)      &kp LG(N8)
&kp F15  &mmv MOVE_UP     &mmv MOVE_LEFT  &mmv MOVE_DOWN       &kp F16        &kp N0                &msc SCRL_UP          &msc SCRL_DOWN        &mkp LCLK            &mkp RCLK
                                       &mmv MOVE_RIGHT &key_repeat    &trans                &trans
            >;
        };

        settings {
            display-name = "Settings";
            bindings = <
&to BASE  &none  &none       &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &none  &none  &none
&kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_NEXT  &kp C_VOL_UP  &kp C_VOL_DN  &kp C_MUTE  &none  &none  &none  &none
&none  &none  &bt BT_CLR  &none         &none         &to BASE         &none         &none  &none  &studio_unlock
                          &none         &none           &none         &none
            >;
        };

        numpad {
            display-name = "Numpad";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &kp KP_DIVIDE  &kp N7  &kp N8  &kp N9  &kp KP_MULTIPLY
&trans  &trans  &trans  &trans  &trans    &trans         &kp N4  &kp N5  &kp N6  &kp KP_MINUS
&trans  &trans  &trans  &trans  &trans    &trans         &kp N1  &kp N2  &kp N3  &kp KP_PLUS
                        &to BASE    &trans    &trans         &kp N0
            >;
        };
    };
};
