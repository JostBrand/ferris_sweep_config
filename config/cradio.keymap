#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Localized German keycodes (keys_de.h): every binding that emits a
// character uses a DE_* code, so hosts configured with a stock German
// layout produce the same characters in the same physical positions
// (Colemak letter positions kept; only the emitted HID usages differ —
// note the QWERTZ Y/Z usage swap: DE_Y / DE_Z). Requires ALL hosts to
// run a German keyboard layout. Header generated by
// https://github.com/joelspadin/zmk-locale-generator (v1.5.0, CLDR
// de-t-k0-windows).
#include "keys_de.h"

#define BASE   0
#define SYM    1
#define SYM_2  2
#define FNC    3
#define FNC_2  4
#define NUMPAD 5
#define UMLAUT 6
#define GAME   7

// ZMK has no parent->child property inheritance: combos need timeout-ms and
// require-prior-idle-ms set per combo, otherwise they silently fall back to
// 50 ms / -1 (disabled) regardless of what the combos node says.
//
// combo_c: common variant (active on BASE..FNC).

#define ZMK_COMBO_C(n, b, kp, i) \
    n { bindings = <b>; key-positions = <kp>; layers = <BASE SYM SYM_2 FNC>; timeout-ms = <50>; require-prior-idle-ms = <i>; };

// combo_a: "everywhere" variant (all layers, for Escape-style combos).
// GAME is listed so to_default (Q + top pinky) also exits game mode.
#define ZMK_COMBO_A(n, b, kp, i) \
    n { bindings = <b>; key-positions = <kp>; layers = <BASE SYM SYM_2 FNC FNC_2 NUMPAD GAME>; timeout-ms = <50>; require-prior-idle-ms = <i>; };

&mt {
    // &mt is only used for tap/tap pairs (COLON+COMMA, UNDER+MINUS) where
    // tap-preferred + a prior-idle guard would only delay the shifted side.
    // Tap/tap resolution never depends on prior idle, so no guard is needed.

    tapping-term-ms = <250>;
    flavor = "tap-preferred";
};

&lt { require-prior-idle-ms = <100>; };

&sl { release-after-ms = <3000>; };

/ {
    combos {
        compatible = "zmk,combos";

        // Destructive / high-risk combos get 150 ms idle, the rest 80 ms.
        // Idle guard: the combo key pair must be pressed after that much
        // typing silence, so fast rolls can't fire them accidentally.
        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <BASE SYM SYM_2 FNC FNC_2 NUMPAD>;
            timeout-ms = <50>;
            require-prior-idle-ms = <0>;
        };
        // Same chord on GAME: menus still need Escape, but an unguarded Q+W
        // would pop the pause menu mid-fight — destructive-combo idle guard.
        esc_game { bindings = <&kp ESCAPE>; key-positions = <0 1>; layers = <GAME>; timeout-ms = <50>; require-prior-idle-ms = <150>; };
        ZMK_COMBO_C(cut,            &kp LC(X),       21 22,  80)
        ZMK_COMBO_C(copy,           &kp LC(C),       22 23,  80)
        ZMK_COMBO_C(paste,          &kp LC(V),       23 24,  80)
        ZMK_COMBO_A(to_default,     &to BASE,        0 9,    80)

        alt_quotes {
            bindings = <&kp DE_DQT>;
            key-positions = <5 6>;
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <80>;
        };

        numpad {
            bindings = <&to NUMPAD>;
            key-positions = <7 8 9>;
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <80>;
        };

        ZMK_COMBO_C(backspace,      &kp BACKSPACE,   3 2,    150)
        ZMK_COMBO_C(delete,         &kp DELETE,      6 7,    150)

        settings {
            bindings = <&to FNC_2>;
            key-positions = <0 1 2>;
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <80>;
        };

        improve_prompt {
            bindings = <&llm_prompt>;
            key-positions = <30 31>;
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        // RET is not destructive; keep the idle guard minimal so fast typing
        // straight into the combo still fires it.

        ZMK_COMBO_C(alt_ret,        &kp RET,         14 13,  30)

        capsword {
            bindings = <&caps_word>;
            key-positions = <29 28>;
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <80>;
        };

        ZMK_COMBO_C(alt_tab,        &kp TAB,         15 16,  80)
        ZMK_COMBO_C(alt_semicolon,  &kp DE_SEMI,     3 4,    80)
        ZMK_COMBO_A(studio_unlock,  &studio_unlock,  20 10 0, 80)

        sym_once {
            // Was &sk SYM: &sk is a sticky *key* and wraps &kp, so this
            // emitted HID keycode 1 instead of the SYM layer.

            bindings = <&sl SYM>;
            key-positions = <20 21>;
            layers = <BASE>;
            timeout-ms = <50>;
            require-prior-idle-ms = <80>;
        };

        ZMK_COMBO_C(undo,           &kp LC(DE_Z),    24 25,  80)
        ZMK_COMBO_C(redo,           &kp LS(LC(DE_Z)), 25 26, 80)

        // Word-deletion pair: F+W sits one column left of the backspace combo
        // (F+P), T+D is its left/right mirror on the home row.

        ZMK_COMBO_C(word_backspace, &kp LC(BACKSPACE), 1 2,  150)
        ZMK_COMBO_C(word_delete,    &kp LC(DELETE),  14 15,  150)
    };

    macros {
        llm_prompt: llm_prompt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LS(RET) &kp I &kp M &kp P &kp R &kp O &kp V &kp E &kp SPACE &kp T &kp H &kp I &kp S &kp SPACE &kp T &kp E &kp X &kp T &kp SPACE &kp A &kp N &kp D &kp SPACE &kp M &kp A &kp K &kp E &kp SPACE &kp I &kp T &kp SPACE &kp C &kp O &kp N &kp C &kp I &kp S &kp E &kp LC(RET)>;
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
            hold-trigger-on-release;
            display-name = "Home Row Mod Left";
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
            hold-trigger-on-release;
            display-name = "Home Row Mod Right";
        };

        // Slash like a real keyboard: tap gives /, holding Shift gives ?.
        // On German hosts / (shift+7) and ? (shift+ß) sit on different
        // physical usages, so a plain &kp DE_SLASH can never produce ? with
        // an already-held Shift — the morph must swap the usage instead.
        slash_qm: slash_question {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_SLASH>, <&kp DE_QUESTION>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            display-name = "Slash / Question Morph";
        };

        // Hold on I activates the UMLAUT layer instead of sending real
        // RAlt: a/o/u/s (and same-hand ü/ö rolls on U/O) then produce
        // ä/ö/ü/ß from their direct German-layout keycodes. A stock German
        // host maps AltGr+letter to æ/↓/ø fraction garbage (or nothing on
        // Windows), never to umlauts — and a leaked RAlt gave @/µ. A
        // momentary layer sends no RAlt HID usage at all, so none of that
        // can leak; a misruled chord just types the base letter.
        hmr_uml: home_row_mod_right_umlaut {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
            // Left-hand keys + U(7)/O(19) on the same hand so ü/ö chords
            // on the right hand resolve to the hold (layer) side.
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 7 19>;
            hold-trigger-on-release;
            display-name = "Home Row Mod Right Umlaut";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Colemak";
            bindings = <
&kp DE_Q            &kp DE_W           &kp DE_F        &kp DE_P             &kp DE_B        &kp DE_J      &kp DE_L              &kp DE_U        &kp DE_Y            &mt DE_UNDER DE_MINUS
&hml LGUI DE_A  &hml LALT DE_R  &hml LCTRL DE_S  &hml LSHFT DE_T  &kp DE_G        &kp DE_M      &hmr RSHFT DE_N  &hmr RCTRL DE_E  &hmr_uml UMLAUT DE_I  &hmr RGUI DE_O
&lt SYM_2 DE_Z          &kp DE_X           &kp DE_C        &kp DE_D             &kp DE_V        &slash_qm  &kp DE_K              &kp DE_H        &mt DE_COLON DE_COMMA  &lt SYM_2 DE_DOT
                                              &mo SYM    &kp SPACE    &mo FNC    &lt SYM RET
            >;
        };

        symbol {
            display-name = "Symbols";
            bindings = <
&kp DE_HASH            &kp DE_AT              &kp DE_LT         &kp DE_GT       &kp DE_TILDE           &kp DE_MINUS  &kp DE_LEFT_BRACE                    &kp DE_RIGHT_BRACE              &kp DE_GRAVE                   &kp DE_COLON
&hml LGUI DE_CARET  &hml LALT DE_EQUAL  &hml LCTRL DE_UNDERSCORE  &hml LSHFT DE_DLLR  &kp DE_ASTRK        &kp DE_PLUS   &hmr RSHFT DE_LPAR  &hmr RCTRL DE_RPAR  &hmr RALT DE_LBKT  &hmr RGUI DE_RBKT
&kp DE_BSLH       &kp DE_PIPE            &kp DE_PRCNT             &kp DE_SEMI               &kp DE_SQT    &kp DE_DQT    &kp DE_EXCL                          &kp DE_AMPS                     &kp DE_UNDER                   &slash_qm
                                                               &trans                 &trans              &trans     &trans
            >;
        };

        number-and-fn {
            display-name = "Numbers & Fn";
            bindings = <
&kp N9             &kp N5       &kp N0         &kp NUMBER_3       &kp N7    &kp N6  &kp NUMBER_2          &kp NUMBER_1       &kp NUMBER_4             &kp N8
&hml LGUI DE_EXCL  &hml LALT DE_AT  &hml LCTRL DE_SQT  &hml LSHFT F4  &trans    &trans  &hmr RSHFT HOME  &hmr RCTRL PAGE_UP  &hmr RALT PAGE_DOWN  &hmr RGUI END
&kp F1             &kp F2       &kp F3         &kp F4             &kp F5    &kp F6  &kp F7                &kp F8             &kp F11                  &kp F12
                                               &trans             &trans    &trans  &trans
            >;
        };

        arrows_wm {
            display-name = "Arrows / WM";
            bindings = <
&to BASE  &kp LG(LS(N5))  &kp UP_ARROW    &kp LG(LS(NUMBER_3))  &trans         &kp LG(LS(NUMBER_6))  &kp LG(LS(NUMBER_2))  &kp LG(LS(NUMBER_1))  &kp LG(LS(NUMBER_4))  &kp LG(LS(N8))
&kp F13   &kp LEFT        &kp DOWN        &kp RIGHT             &kp F14        &kp LG(NUMBER_6)      &kp LG(NUMBER_2)      &kp LG(NUMBER_1)      &kp LG(NUMBER_4)      &kp LG(N8)
&kp F15   &mmv MOVE_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN        &kp F16        &kp N0                &msc SCRL_UP          &msc SCRL_DOWN        &mkp LCLK             &mkp RCLK
                                          &mmv MOVE_RIGHT       &key_repeat    &trans                &trans
            >;
        };

        settings {
            display-name = "Settings";
            // Top right (position 9): types "a" — tap it to see which host
            // receives input, i.e. which BT profile is currently active.
            bindings = <
&to BASE  &none  &none       &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &none  &none  &kp DE_A
&kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_NEXT  &kp C_VOL_UP  &kp C_VOL_DN  &kp C_MUTE  &none  &none  &none  &none
&none  &none  &bt BT_CLR  &none         &none         &to BASE         &to GAME         &none  &none  &studio_unlock
                          &none         &none           &none         &none
            >;
        };

        numpad {
            display-name = "Numpad";
            // ä/ö/ü are direct German-layout keys on the A/O/U letter
            // positions; Shift/CapsLock gives uppercase. u/o displace N8 and
            // KP_MINUS (unused), a was transparent. ß intentionally absent
            // (Swiss keyboarding).
            bindings = <
&trans  &trans  &trans  &trans  &trans    &kp KP_DIVIDE  &kp N7  &kp DE_U_UMLAUT  &kp N9  &kp KP_MULTIPLY
&kp DE_A_UMLAUT  &trans  &trans  &trans  &trans    &trans         &kp N4  &kp N5  &kp N6  &kp DE_O_UMLAUT
&trans  &trans  &trans  &trans  &trans    &trans         &kp N1  &kp N2  &kp N3  &kp KP_PLUS
                        &to BASE    &trans    &trans         &kp N0
            >;
        };

        umlaut {
            display-name = "Umlauts";
            // Momentary while I is held (hmr_uml). a/o/u/s become the
            // direct German-layout keys ä/ö/ü/ß; Shift/CapsLock give
            // uppercase. Everything else stays &trans, so overlapping
            // rolls fall through to the base letter untouched.
            bindings = <
&trans              &trans  &trans      &trans  &trans    &trans  &trans  &kp DE_U_UMLAUT  &trans  &trans
&kp DE_A_UMLAUT  &trans  &kp DE_SZ  &trans  &trans   &trans  &trans  &trans      &trans     &kp DE_O_UMLAUT
&trans              &trans  &trans      &trans  &trans    &trans  &trans  &trans           &trans  &trans
                                    &trans  &trans    &trans  &trans
            >;
        };

        game {
            display-name = "Game";
            // Base layer with every hold behavior stripped: home row keys
            // are plain letters (no mods), Z/DOT/RET lose their &lt holds
            // so a long key hold can never flip layers mid-game. Thumb &mo
            // keys stay, keeping arrows/F-keys/mouse (FNC) and symbols
            // reachable. Enter via settings (&to GAME next to &to BASE);
            // exit with the to_default combo (Q + top pinky). No other
            // combo lists GAME, so chords can't misfire — only esc_game
            // (Q+W with a 150 ms idle guard) fires Escape.
            bindings = <
&kp DE_Q  &kp DE_W  &kp DE_F  &kp DE_P  &kp DE_B    &kp DE_J  &kp DE_L  &kp DE_U  &kp DE_Y  &mt DE_UNDER DE_MINUS
&kp DE_A  &kp DE_R  &kp DE_S  &kp DE_T  &kp DE_G    &kp DE_M  &kp DE_N  &kp DE_E  &kp DE_I  &kp DE_O
&kp DE_Z  &kp DE_X  &kp DE_C  &kp DE_D  &kp DE_V    &slash_qm  &kp DE_K  &kp DE_H  &mt DE_COLON DE_COMMA  &kp DE_DOT
                             &mo SYM  &kp SPACE  &mo FNC  &kp RET
            >;
        };
    };
};
